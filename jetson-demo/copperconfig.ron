        (
            id: "lossy2",
            type: "cu_jetson_camera::CuH265Encoder",
            config: {"fps": 10, "compression": {"cbr": {"bitrate_bps": 8000000}}},
        ),
        (id: "archive2", type: "CountFrames", config: {"name": "camera2/lossless"}),
