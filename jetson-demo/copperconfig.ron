(
    logging: (
        enable_task_logging: true,
        enable_keyframe_logging: false,
        copperlist_count: 8,
        section_size_mib: 192,
        slab_size_mib: 512,
    ),
    runtime: (rate_target_hz: 240),
    tasks: [
        (
            id: "camera0",
            type: "cu_jetson_camera::CuJetsonCamera",
            config: {"device": "/dev/cams/des0/port0/sensor0", "fps": 10},
            logging: (enabled: false),
        ),
        (id: "prepare0", type: "cu_jetson_camera::CuYuv444", logging: (enabled: false)),
        (id: "lossless0", type: "cu_jetson_camera::CuH265Encoder", config: {"fps": 10}),
        (
            id: "lossy0",
            type: "cu_jetson_camera::CuH265Encoder",
            config: {"fps": 10, "compression": {"cbr": {"bitrate_bps": 8000000}}},
        ),
        (id: "archive0", type: "CountFrames", config: {"name": "camera0/lossless"}),
        (id: "preview0", type: "CountFrames", config: {"name": "camera0/lossy"}),
        (
            id: "camera1",
            type: "cu_jetson_camera::CuJetsonCamera",
            config: {"device": "/dev/cams/des0/port1/sensor0", "fps": 10},
